# Copy to .env and fill in real values. Never commit .env.

# Neon Postgres (written by `neon deploy` or `neon env pull`)
# Pooled URL (hostname has -pooler), used by the running app
DATABASE_URL=postgresql://user:password@ep-example-pooler.eu-west-2.aws.neon.tech/neondb?sslmode=require
# Direct URL, used by init_db.py to create tables
DATABASE_URL_UNPOOLED=postgresql://user:password@ep-example.eu-west-2.aws.neon.tech/neondb?sslmode=require
NEON_BRANCH=production

# Flask session signing key. Generate one with:
#   python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=change-me

# Code people must enter to sign up. Sign-up is closed while this is empty.
INVITE_CODE=change-me
